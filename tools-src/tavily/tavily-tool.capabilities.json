{
  "version": "0.1.0",
  "wit_version": "0.3.0",
  "capabilities": {
    "http": {
      "allowlist": [
        {
          "host": "api.tavily.com",
          "path_prefix": "/search",
          "methods": [
            "POST"
          ]
        }
      ],
      "credentials": {
        "tavily_api_key": {
          "secret_name": "tavily_api_key",
          "location": {
            "type": "bearer"
          },
          "host_patterns": [
            "api.tavily.com"
          ]
        }
      },
      "rate_limit": {
        "requests_per_minute": 30,
        "requests_per_hour": 1000
      }
    },
    "secrets": {
      "allowed_names": [
        "tavily_api_key"
      ]
    }
  },
  "auth": {
    "secret_name": "tavily_api_key",
    "display_name": "Tavily",
    "instructions": "Get your Tavily API key from app.tavily.com",
    "setup_url": "https://app.tavily.com/",
    "env_var": "TAVILY_API_KEY"
  },
  "setup": {
    "required_secrets": [
      {
        "name": "tavily_api_key",
        "prompt": "Tavily API key (from app.tavily.com)"
      }
    ]
  }
}
